import java.util.Scanner;
class ProductSum 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a Number : ");
		
		int num = sc.nextInt();
		
		int sum = 0;
		int product = 1;
		
		if(num == 0)
		{
			sum = 0;
			product = 0;
		}
		
		
		while(num > 0)
		{
			int last = num % 10;
			
			sum = sum + last;
			
			product = product * last;
			
			num = num / 10;
		}
		
		if(sum == product)
		{
			System.out.println("Sum of number and Product of number is equals");
		}
		else
		{
			System.out.println("Sum of number and Product of number is not equals");
		}
		
	}
}
