class PrimeSum 
{
	public static void main(String[] args) 
	{
		int sum = 0;
		for(int i = 1; i <= 10; i++)
		{
			if(isPrime(i))
			{
				sum = sum + i;
			}
		}
		
		System.out.println(sum);
	}
	
	public static boolean isPrime(int num)
	{
		if(num <= 1)
		{
			return false;
		}
		else
		{
			for(int i = 2; i <= num / 2; i++)
			{
				if(num % i == 0)
				{
					return false;
				}
			}
			
			return true;
		}
	}
}
