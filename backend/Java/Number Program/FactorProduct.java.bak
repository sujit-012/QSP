import java.util.Scanner;
class FactorProduct 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number : ");
		int num = sc.nextInt();
		
		int product = 1;
		
		for(int i = 1; i <= num; i++)
		{
			if(num % 1 == 0)
			{
				product = product * i;
			}
		}
		
		System.out.println("Product of factor of " + num + " is " + product);
	}
}
