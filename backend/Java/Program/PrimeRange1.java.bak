class PrimeRange 
{
	public static void main(String[] args) 
	{
		for(int i = 100; i <= 150; i++)
		{
			if( i <= 1)
			{
				continue;
			}
			else
			{
				boolean isPrime = true;
				
				for(int j = 2; j <= i / 2; j++)
				{
					if( i % j == 0)
					{
						isPrime = false;
						break;
					}
				}
				
				if(isPrime)
				{
					System.out.println(i);
				}
			}
		}
	}
}
