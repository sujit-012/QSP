import java.util.Scanner;
class EvenDigit 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number : ");
		int num = sc.nextInt();j
		
		while(num > 0)
		{
			int last = num % 10;
			
			if(last % 2 == 0)
			{
				System.out.println(last);
			}
			
			num = num / 10;
		}
	}
}
