class NumtoBin 
{
	public static void main(String[] args) 
	{
		int num = 120;
		String bin = "";
		
		while(num > 0)
		{
			int rem = num%2;
			bin = rem + bin;
			num = num/2;
		}
		
		System.out.println(bin);
		
		int num2 = 0;
		for(int i = bin.length() - 1, j = 0; i >= 0; i--, j++)
		{
			int dig = bin.charAt(i) - '0';
			int power = powerNum(2, j);
			int prd = power*dig;
			num2 = num2 + prd;
		}
		
		System.out.println(num2);
	}
	
	public static int powerNum(int num, int pow)
	{
		int pro = 1;
		for(int i = 1; i <= pow; i++)
		{
			pro = pro * num;
		}
		
		return pro;
	}
}
