import java.util.Scanner;
class Pattern10 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number of row : ");
		int n = sc.nextInt();
		
		int num = 0;
		
		for(int i = 1; i <= n; i++)
		{
			for(int j = 1; j <= n-i; j++)
			{
				System.out.print(" "+" ");
			}
			
			num = 1;

			for(int j = 1; j <= 2 * i - 1; j++)
			{
				System.out.print(num);

				if(j < i)
				{
					num++;
					
				}
				else
				{
					num--;
				}
			}
			System.out.println();
		}
	}
}
