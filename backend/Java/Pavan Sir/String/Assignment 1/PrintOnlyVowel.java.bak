class PrintOnlyVowel 
{
	public static void main(String[] args) 
	{
		System.out.println("Hello World!");
	}
	
	public static void printOnlyVowel(String str)
	{
		for(int i = 0; i < str.length(); i++)
		{
			char ch = str.charAt(i);
				if(ch == 'A' || ch == 'a' ||
				ch == 'E' || ch == 'e' ||
				ch == 'I' || ch == 'i' ||
				ch == 'O' || ch == 'o' ||
				ch == 'U' || ch == 'u')
			{
				System.out.println(ch);;
			}
		}
	}
}
