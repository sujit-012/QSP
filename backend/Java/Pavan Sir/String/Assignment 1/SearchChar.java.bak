class SearchChar 
{
	public static void main(String[] args) 
	{
		String str = "Hello Java 21 @ Pune# AEIOU xyz 123!";
		System.out.println(search(str, '&'));
	}
	
	public static boolean search(String str, char ch)
	{
		for(int i = 0; i < str.length(); i++)
		{
			if(str.charAt(i) == ch)
			{
				return true;
			}
		}
		
		return false;
	}
}
