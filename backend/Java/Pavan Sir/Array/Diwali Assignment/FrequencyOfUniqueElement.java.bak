class FrequencyOfUniqueElement 
{
	public static void main(String[] args) 
	{
		int[] a = {1, 2, 2, 3, 1, 4};
		printFrequencyOfUniqueEle(a);
	}
	
	public static void printFrequencyOfUniqueEle(int [] n)
	{
		boolean[] visited = new boolean[n.length];
		
		for(int i = 0; i < n.length; i++) 
		{
			if(visited[i])
			{
				continue; 
			}
			
			int count = 1; 
			
			for(int j = i + 1; j < n.length; j++) 
			{
				if(n[i] == n[j]) 
				{
					count++;
					visited[i] = true; 
				}
			}
			
			if(count == 1) 
			{
				System.out.println(n[i] + " ===> " + count);
			}
		}
	}
}
