class LastUniqueElement 
{
	public static void main(String[] args) 
	{
		int[] a = {5, 2, 8, 2, 5, 9, 3, 9, 4};
		System.out.println(printLastUnique(a));
	}
	
	public static int printLastUnique(int [] n)
	{
		for(int i = n.length - 1; i >= 0; i--)
