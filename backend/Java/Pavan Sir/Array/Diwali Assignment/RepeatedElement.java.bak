class RepeatedElement 
{
	public static void main(String[] args) 
	{
		int[] a = {1, 2, 72, 2, 67, 3, 1, 4, 1098, 3, 1098, 3289, 38, 438};
		printRepeated(a);
	}
	
	public static void printRepeated(int [] n)
	{
		boolean[] visited = new visited[n.length];
		
		for(int i = 0; i < n.length; i++)
		{
			if(visited[i])
			{
				continue;
			}
			
			int count = 1;
			
			for(int j = i + 1; j < n.length; j++)
			{
				if(n[i] == n[j])
				{
					count++;
					visited[j] = true;
				}
			}
			
			if(count > 1)
			{
				System.out.println(n[i]);
			}
		}
	}
}
