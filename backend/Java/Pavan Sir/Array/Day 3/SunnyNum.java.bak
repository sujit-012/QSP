	public static int countOfSunnyNum(int [] n)
	{
		int count = 0;
		
		for(int i = 0; i < n.length; i++)
		{
			if(isSunnyNum(n[i] + 1))
			{
				System.out.println(n[i]);
				count++;
			}
		}
		return count;
	}
	
	public static boolean isSunnyNum(int num)
	{
		for(int i = 1; (i*i) <= num; i++)
		{
			if((i*i) == num)
			{
				return true;
			}
		}
		
		return false;
	}
}

