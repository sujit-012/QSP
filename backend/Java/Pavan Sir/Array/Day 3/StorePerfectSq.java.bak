class StorePerfectSq 
{
	public static void main(String[] args) 
	{
		int [] a = {7, 64, 89, 4, 19, 100, 101};
		int [] n = storePerfectSq(a);
		
		for(int i = 0; i < n.length; i++)
		{
			System.out.println(n[i]);
		}
	}
	
	public static int[] storePerfectSq(int [] n)
	{
		int size = countOfPerfectSq(n);
		int [] perfectSq = new int[size];
		int index = 0;
		
		for(int i = 0; i < n.length; i++)
		{
			if(isPerfectSq(n[i]))
			{
				perfectSq[index] = n[i];
				index++;
			}
		}
		
		return perfectSq;
	}
	
	public static int countOfPerfectSq(int [] n)
	{
		int count = 0;
		
		for(int i = 0; i < n.length; i++)
		{
			if(isPerfectSq(n[i]))
			{
				System.out.println(n[i]);
				count++;
			}
		}
		
		return count;
	}
	
	public static boolean isPerfectSq(int num)
	{
		for(int i = 1; (i*i) <= num; i++)
		{
			if((i*i) == num)
			{
				return true;
			}
		}
		
		return false;
	}
}
