class SumOfOdd 
{
	public static void main(String[] args) 
	{
		int [] a = {10, 20, 30, 40, 50};
		System.out.println(sumOfOdd(a));
	}
	
	public static int sumOfOdd(int [] num)
	{
		int sum = 0;
		for(int i = 0; i < num.length; i++)
		{ 
			if(num[i] % 2 != 0)
			{
				sum += num[i];
			}
		}
		return sum;
	}
}
