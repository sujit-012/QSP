class SumOfLastThree 
{
	public static void main(String[] args) 
	{
		int [] a = {10, 20, 30, 40, 50};
		System.out.println(sumOfLasThree(a));
	}
	
	public static int sumOfLastThree(int []num)
	{
		int sum = 0;
		
		for(int i = num.length-3; i < num.length; i++)
		{
			sum = sum + num[i];
		}
		return sum;
	}
}
