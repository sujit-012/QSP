import java.util.Arrays;

class SegPrimeNonPrime 
{
	public static void main(String[] args) 
	{
		int[] a = {17, 42, 3, 91, 23, 56, 11, 8, 67, 25};
		System.out.println(Arrays.toString(a));
		segPrimeNonPrime(a);
		System.out.println(Arrays.toString(a));
	}
	
	public static void segPrimeNonPrim(int [] n)
	{
		int i = 0;
		int j = n.length - 1;
		
		while(i < j)
		{
			if(isPrime(n[i]))
			{
				i++;
			}
			else if(!isPrime(n[j]))
			{
				j--;
			}
			else
			{
				int temp = n[i];
				n[i] = n[j];
				n[j] = temp;
			}
		}
	}
	
	public static boolean isPrime(int num)
	{
		if(num <= 1) 
		{
			return false;
		}
		
		for(int i = 2; i <= num / 2; i++)
		{
			if(num % i == 0)
			{
				return false;
			}
		}
		
		return true;
	}
}
