import java.util.Arrays;

class SegUpperCaseLowerCase 
{
	public static void main(String[] args) 
	{
		char [] a = {'A', 'i', 'G', 'U', 'K', 'S'};
		System.out.println(Arrays.toString(a));
		segUpperLower(a);
		System.out.println(Arrays.toString(a));
	}
	
	public static void segUpperLower(char [] c)
	{
		int i = 0;
		int j = c.length - 1;
		
		while(i < j)
		{
			if(c[i] >= 'A' && c[i] <= 'Z')
			{
				i++;
			}
			else if (c[j] >= 'a' && c[j] <= 'z')
			{
				j--;
			}
			else
			{
				char temp = c[i];
				c[i] = c[j];
				c[j] = temp;
			}
		}
	}
}
