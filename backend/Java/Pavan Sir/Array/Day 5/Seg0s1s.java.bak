import java.util.Arrays;

class Seg0s1s 
{
	public static void main(String[] args) 
	{
		int [] a = {1, 1, 0, 1, 0, 1, 0};
		System.out.println(Arrays.toString(a));
		seg0s1s(a);
		System.out.println(Arrays.toString(a));
	}
	
	public static void seg0s1s(int [] n)
	{
		int i = 0;
		int j = n.length - 1;
		
		while(i < j)
		{
			if(n[i] == 1)
			{
				i++;
			}
			else if(n[i] == 0)
			{
				j--;
			}
			else
			{
				int temp = n[i];
				n[i] = n[j];
				n[j] = temp;
			}
		}
	}
}
