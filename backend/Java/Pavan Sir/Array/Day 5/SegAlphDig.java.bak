import java.util.Arrays;

class SegAlphDig 
{
	public static void main(String[] args) 
	{
		char [] ch = {'a','8', '2', 'G', 'U', '9', 'k', '4'};
		System.out.println(Arrays.toString(ch));
		segAlphDig(a);
		System.out.println(Arrays.toString(ch));
	}
	
	public static void segAlphDig(char [] c)
	{
		int i = 0;
		int j = c.length - 1;
		
		while(i < j)
		{
			if ((c[i] >= 'A' && c[i] <= 'Z') || (c[i] >= 'a' && c[i] <= 'z'))
			{
				i++;
			}
			else if(c[j] >= '0' && c[j] <= '9')
			{
				j--;
			}
			else
			{
				char temp = c[i];
				c[i] = c[j];
				c[j] = temp;
			}
		}
	}
}
