class FirstVowel
 
{
	public static void main(String[] args) 
	{
		char[] ch = {'#', 'T', 'm', 'E', '7', 'a'};
		System.out.println(firstVowel(ch));
	}
	
	public static void firstVowel(char [] c)
	{
		for(int i = 0; i < c.length; i++)
		{
			if(c[i] == 'A' || c[i] == 'a' ||
				c[i] == 'E' || c[i] == 'e' ||
				c[i] == 'I' || c[i] == 'i' ||
				c[i] == 'O' || c[i] == 'o' ||
				c[i] == 'U' || c[i] == 'u' )
			{
				System.out.println(c[i]);
				break;
			}
		}
	}
}
