import java.util.Scanner;
class Rotation 
{
	static int temp;
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number : ");
		int num = sc.nextInt();
		temp = num;
		
		int div = div(num, 1);
		rotation((num%10)*div + num/10, div);
	}
	
	public static void rotation(int num, int div)
	{
		if(temp == num)
		{
			System.out.println(num);
		}
		
		System.out.println(num);
		
		rotation((num%10)*div + num/10, div);
	}
	
	public static int div(int num, int ans)
	{
		if(num < 10) return ans;
		
		return div(num/10, ans*10);
	}
}
