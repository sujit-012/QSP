class p3 
{
	public static void main(String[] args) 
	{
		int n = 5;
		char ch = 'a';
		int no = 1;
		for(int i = 0; i < n; i++)
		{
			for(int j = 0; j < n; j++)
			{
				if(i%2 == 0)
				{
					if(no <= 9)
					{
						System.out.print(no++ + "  ");
					}
					else
					{
						System.out.print(no++ + " ");
					}
				}
				else
				{
					System.out.print((ch++) + " ");
				}
			}
			System.out.println();
		}
	}
}
