import java.util.Scanner;
class ReversePattern 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		
		int num = n*n;
		
		for(int i = 1; i <= n; i++)
		{
			for(int j = 1; j <= n; j++)
			{
				System.out.print(num-- + " ");
				if(num < 9) System.out.print(" ");
			}
			System.out.println();
		}
	}
}
