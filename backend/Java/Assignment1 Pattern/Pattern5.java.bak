import java.util.Scanner;
class Pattern5 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number of rows : ");
		int n = sc.nextInt();
		
		int a = (n*2) - 1;
		int b = 1;
		
		for(int i = 1; i<=n; i++)
		{
			int num = i;
			for(int j = 1; j <= n; j++)
			{
				System.out.print(num + " ");
				if(num <= 9) System.out.print(" ");
				if(j%2 != 0)
				{
					num += a;
				}
				else
				{
					num += b;
				}
			}
			System.out.println();
			a -= 2;
			b += 2;
		}s
				
	}
}
