import java.util.Scanner;
class Pattern21 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number of rows : ");
		int n = sc.nextInt();
		
		int a = 1;
		char b = 'a';
		
		fot(int i = 1; i <= n; i++)
		{
			for(int j = 1; j <= n; j++)
			{
				if(i >= j)
				{
					System.out.print(a++ + " ");
					if(a <= 10) System.out.print(" ");
				}
				else
				{
					System.out.print(b++ + "  ");
				}
			}
			System.out.println();
		}
	}
}
