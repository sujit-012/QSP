import java.util.Scanner;
class Pattern19 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number of rows : ");
		int n = sc.nextInt();
		
		for(int i = 1; i <= n; i++)
		{
			int num = (n*n)/2 + 1 - i;
			for(int j = 1; j <= n; j++)
			{
				if(j%2 != 0)
				{
					System.out.print(num + " ");
					if(num <= 9) System.out.print(" ");
				}
				else
				{
					char ch = (char) ('a' + (n * n)/2 - num);
					System.out.print(ch + "  ");
				}
			}
			System.out.println();
		}
	}
}
