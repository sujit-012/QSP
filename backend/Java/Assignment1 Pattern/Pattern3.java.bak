import java.util.Scanner;
class Pattern3 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number of rows : ");
		int n = sc.nextInt();
		
		int num = 1;
		
		for(int i = 1; i <= n; i++)
		{
			for(int j = 1; j <= n; j++)
			{
				if(i % 2 != 0)
				{
					System.out.print(num++ + " ");
				}
				else
				{
					System.out.print(num-- + " ");
				}
			}
			
			System.out.println();
			if((i % 2) != 0)
			{
				num += (n-1);
			}
			else
			{
				num += (n+1);
			}
		}
	}
}
