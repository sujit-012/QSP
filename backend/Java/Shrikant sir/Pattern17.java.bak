import java.util.Scanner;
class Pattern17 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number of rows : ");
		int n = sc.nextInt();
		
		int num = (n*n)/2;
		char ch = 'a';
		
		for(int i = 1; i <= n; i++)
		{
			for(int j = 1; j <= n; j++)
			{
				if(i%2 != 0)
				{
					System.out.print(num-- + " ");
					if(num < 9) System.out.print(" ");
				}
				else
				{
					System.out.print(ch++ + "  ");
				}
			}
			System.out.println();
		}
	}
}
